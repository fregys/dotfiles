{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "right": [
        {
          "id": "agx.screen-time",
          "iconOnly": true
        },
        {
          "id": "omarchy.tray"
        },
        {
          "id": "io.github.5d0tal1gat0r.stocks",
          "chartRange": "1d",
          "currencies": [
            "USD",
            "CZK",
            "EUR"
          ],
          "currency": "",
          "symbols": [
            "VOO",
            "INTC",
            "AMZN",
            "GOOGL",
            "MU",
            "SNDK",
            "LRCX",
            "TSM",
            "ASML",
            "NVDA",
            "NVO",
            "BTC-USD",
            "EURCZK=X",
            "CZK=X"
          ]
        },
        {
          "id": "im0001gt.hw-tooltip"
        },
        {
          "apps": "slack,discord,beeper,zen,spotify,signal",
          "id": "jankeesvw.notification-center",
          "keepDays": 2,
          "rules": [
            {
              "app": "omarchy-action",
              "summary": "^Reminder$"
            }
          ]
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "willy.vpn"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "cloneSourceRestores": [
    "willy.clipboard"
  ],
  "disabledPlugins": [
    "omarchy.clipboard"
  ],
  "idle": {
    "lock": 900,
    "screensaver": 840
  },
  "plugins": [
    {
      "id": "willy.todos"
    },
    {
      "id": "willy.clipboard"
    }
  ],
  "version": 1
}
